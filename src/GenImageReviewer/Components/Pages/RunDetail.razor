@page "/run/{Id:int}"
@using GenImageReviewer.Data
@using GenImageReviewer.Providers
@using GenImageReviewer.Services
@using System.Text.Json
@inject ComparisonService ComparisonService
@inject NavigationManager Nav

<PageTitle>Comparison Run @Id</PageTitle>

@if (_run is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
               OnClick="@(() => Nav.NavigateTo("/"))" Class="mb-4">
        Back
    </MudButton>

    <MudText Typo="Typo.h5" Class="mb-1">Comparison Run #@_run.Id</MudText>
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
        @_run.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") &bull;
        @_run.Width&times;@_run.Height &bull; @_run.Quality quality
    </MudText>

    <MudPaper Class="pa-3 mb-4" Elevation="1">
        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Prompt</MudText>
        <MudText Typo="Typo.body1">@_run.Prompt</MudText>
        @if (!string.IsNullOrEmpty(_run.NegativePrompt))
        {
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mt-2">Negative</MudText>
            <MudText Typo="Typo.body2">@_run.NegativePrompt</MudText>
        }
    </MudPaper>

    @if (_run.ReferenceImageData is not null)
    {
        <MudPaper Class="pa-3 mb-6 d-flex align-center gap-4" Elevation="1">
            <div>
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-1">Reference Image</MudText>
                <MudImage Src="@GetReferenceDataUrl()" Height="120" ObjectFit="ObjectFit.Cover"
                          Style="border-radius:4px" />
            </div>
        </MudPaper>
    }

    @foreach (var round in _run.Results.Select(r => r.Round).Distinct().OrderBy(r => r))
    {
        var roundResults = _run.Results.Where(r => r.Round == round)
                               .OrderByDescending(r => r.OverallScore)
                               .ToList();

        <div class="mb-6">
            <MudText Typo="Typo.h6" Class="mb-3">
                @if (round == 1)
                {
                    <span>Original Results</span>
                }
                else
                {
                    <span>Round @round</span>
                }
            </MudText>

            <MudGrid>
                @foreach (var result in roundResults)
                {
                    <MudItem xs="12" sm="6" lg="4">
                        <MudCard>
                            <MudCardHeader>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.h6">@result.ProviderDisplayName</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @((result.GenerationDurationMs / 1000.0).ToString("F1"))s generation
                                    </MudText>
                                </CardHeaderContent>
                                <CardHeaderActions>
                                    @if (result.OverallScore.HasValue)
                                    {
                                        <MudChip T="string" Color="@ScoreColor(result.OverallScore.Value)" Size="Size.Small">
                                            @result.OverallScore/10
                                        </MudChip>
                                    }
                                </CardHeaderActions>
                            </MudCardHeader>

                            @if (result.GenerationSuccess && result.ImageData is not null)
                            {
                                <MudCardMedia Image="@GetDataUrl(result)" Height="300" />
                            }
                            else
                            {
                                <MudPaper Class="ma-2 pa-4 d-flex align-center justify-center" Style="height:300px" Elevation="0" Outlined="true">
                                    <div class="text-center">
                                        <MudIcon Icon="@Icons.Material.Filled.BrokenImage" Size="Size.Large" Color="Color.Error" />
                                        <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-2">@result.GenerationError</MudText>
                                    </div>
                                </MudPaper>
                            }

                            <MudCardContent>
                                @if (result.ReviewCompleted)
                                {
                                    var colSize = result.ReferenceAccuracyScore.HasValue ? 3 : 4;

                                    <MudGrid Class="mb-3">
                                        <MudItem xs="@colSize" Class="text-center">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Accuracy</MudText>
                                            <MudText Typo="Typo.h6" Color="@ScoreColor(result.AccuracyScore ?? 0)">
                                                @result.AccuracyScore<MudText Typo="Typo.caption">/10</MudText>
                                            </MudText>
                                        </MudItem>
                                        <MudItem xs="@colSize" Class="text-center">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Quality</MudText>
                                            <MudText Typo="Typo.h6" Color="@ScoreColor(result.QualityScore ?? 0)">
                                                @result.QualityScore<MudText Typo="Typo.caption">/10</MudText>
                                            </MudText>
                                        </MudItem>
                                        @if (result.ReferenceAccuracyScore.HasValue)
                                        {
                                            <MudItem xs="@colSize" Class="text-center">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Ref Match</MudText>
                                                <MudText Typo="Typo.h6" Color="@ScoreColor(result.ReferenceAccuracyScore.Value)">
                                                    @result.ReferenceAccuracyScore<MudText Typo="Typo.caption">/10</MudText>
                                                </MudText>
                                            </MudItem>
                                        }
                                        <MudItem xs="@colSize" Class="text-center">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Overall</MudText>
                                            <MudText Typo="Typo.h6" Color="@ScoreColor(result.OverallScore ?? 0)">
                                                @result.OverallScore<MudText Typo="Typo.caption">/10</MudText>
                                            </MudText>
                                        </MudItem>
                                    </MudGrid>

                                    @if (!string.IsNullOrEmpty(result.Commentary))
                                    {
                                        <MudText Typo="Typo.body2" Class="mb-3">@result.Commentary</MudText>
                                    }

                                    @if (GetDefects(result.DefectsJson) is { Count: > 0 } defects)
                                    {
                                        <MudText Typo="Typo.subtitle2" Color="Color.Warning">Defects detected</MudText>
                                        <MudList T="string" Dense="true">
                                            @foreach (var defect in defects)
                                            {
                                                <MudListItem Icon="@Icons.Material.Filled.Warning" IconColor="Color.Warning">
                                                    @defect
                                                </MudListItem>
                                            }
                                        </MudList>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small">
                                            No defects detected
                                        </MudChip>
                                    }
                                }
                                else if (!string.IsNullOrEmpty(result.ReviewError))
                                {
                                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                                        Review failed: @result.ReviewError
                                    </MudAlert>
                                }
                                else if (result.GenerationSuccess)
                                {
                                    <MudProgressLinear Indeterminate="true" Color="Color.Secondary" />
                                    <MudText Typo="Typo.caption">Awaiting review…</MudText>
                                }
                            </MudCardContent>

                            <MudCardActions>
                                @if (result.GenerationSuccess && result.ImageData is not null)
                                {
                                    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Download"
                                               Href="@GetDataUrl(result)" download="@($"{result.ProviderName}.png")">
                                        Download
                                    </MudButton>
                                }
                                @if (result.GenerationSuccess && result.ImageData is not null &&
                                     (!result.ReviewCompleted || !string.IsNullOrEmpty(result.ReviewError)))
                                {
                                    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh"
                                               Color="Color.Secondary"
                                               Disabled="@_retryingIds.Contains(result.Id)"
                                               OnClick="@(() => RetryReviewAsync(result.Id))">
                                        @(_retryingIds.Contains(result.Id) ? "Retrying…" : "Retry Review")
                                    </MudButton>
                                }
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        </div>
    }

    <MudDivider Class="mb-4" />

    <MudExpansionPanels>
        <MudExpansionPanel Text="Regenerate Images" Icon="@Icons.Material.Filled.Refresh">
            @if (_regenerating)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
                @foreach (var msg in _regenLog)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@msg</MudText>
                }
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mb-3">
                    Select providers to regenerate. Original results are preserved as Round 1.
                </MudText>

                @foreach (var provider in ComparisonService.AvailableProviders)
                {
                    <MudCheckBox @bind-Value="_regenProviders[provider.Name]"
                                 Label="@provider.DisplayName" Color="Color.Primary" Class="mb-1" />
                }

                <div class="mt-3">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.PlayArrow"
                               Disabled="@(!_regenProviders.Any(kv => kv.Value))"
                               OnClick="RegenerateAsync">
                        Run
                    </MudButton>
                </div>
            }
        </MudExpansionPanel>
    </MudExpansionPanels>

    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private ComparisonRun? _run;
    private string? _error;

    private readonly HashSet<int> _retryingIds = [];

    private bool _regenerating;
    private readonly List<string> _regenLog = [];
    private Dictionary<string, bool> _regenProviders = [];

    protected override async Task OnInitializedAsync()
    {
        _run = await ComparisonService.GetRunAsync(Id);
        _regenProviders = ComparisonService.AvailableProviders
            .ToDictionary(p => p.Name, _ => true);
    }

    private async Task RetryReviewAsync(int resultId)
    {
        _retryingIds.Add(resultId);
        _error = null;
        StateHasChanged();

        try
        {
            await ComparisonService.RetryReviewAsync(resultId);
            _run = await ComparisonService.GetRunAsync(Id);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _retryingIds.Remove(resultId);
            StateHasChanged();
        }
    }

    private async Task RegenerateAsync()
    {
        _regenerating = true;
        _regenLog.Clear();
        _error = null;

        var progress = new Progress<string>(msg =>
        {
            _regenLog.Add(msg);
            InvokeAsync(StateHasChanged);
        });

        var selected = _regenProviders.Where(kv => kv.Value).Select(kv => kv.Key);

        try
        {
            await ComparisonService.RegenerateAsync(Id, selected, progress);
            _run = await ComparisonService.GetRunAsync(Id);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _regenerating = false;
            StateHasChanged();
        }
    }

    private static string GetDataUrl(ComparisonResult r) =>
        $"data:{r.MimeType};base64,{Convert.ToBase64String(r.ImageData!)}";

    private string GetReferenceDataUrl() =>
        _run?.ReferenceImageData is not null
            ? $"data:{_run.ReferenceImageMimeType};base64,{Convert.ToBase64String(_run.ReferenceImageData)}"
            : "";

    private static List<string> GetDefects(string? json)
    {
        if (string.IsNullOrEmpty(json)) return [];
        try { return JsonSerializer.Deserialize<List<string>>(json) ?? []; }
        catch { return []; }
    }

    private static Color ScoreColor(int score) => score switch
    {
        >= 8 => Color.Success,
        >= 5 => Color.Warning,
        _    => Color.Error
    };
}
